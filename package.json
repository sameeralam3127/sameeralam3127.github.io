    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
