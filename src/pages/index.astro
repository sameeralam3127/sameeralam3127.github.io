---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Architecture from "@/components/sections/Architecture.astro";
import Contact from "@/components/sections/Contact.astro";
import Credentials from "@/components/sections/Credentials.astro";
import Experience from "@/components/sections/Experience.astro";
import GitHubDashboard from "@/components/github/GitHubDashboard.astro";
import Hero from "@/components/sections/Hero.astro";
import Incident from "@/components/sections/Incident.astro";
import Principles from "@/components/sections/Principles.astro";
import Projects from "@/components/sections/Projects.astro";
import Stack from "@/components/sections/Stack.astro";
import SystemStatus from "@/components/sections/SystemStatus.astro";
import Writing from "@/components/sections/Writing.astro";
import { personSchema, websiteSchema } from "@/lib/structured-data";
---

<BaseLayout ogType="profile" jsonLd={[personSchema(), websiteSchema()]}>
  <Hero />
  <Principles />
  <Stack />
  <Projects />
  <GitHubDashboard />
  <Incident />
  <Architecture />
  <SystemStatus />
  <Experience />
  <Credentials />
  <Writing />
  <Contact />
</BaseLayout>
