---
import IncidentSimulator from "@/components/islands/IncidentSimulator";
import SectionHeading from "@/components/ui/SectionHeading.astro";
---

<section aria-labelledby="incident" class="mx-auto max-w-6xl px-4 pt-24 sm:px-6" data-reveal>
  <SectionHeading
    id="incident"
    command="pagerduty incident ack --on-call=you"
    title="Incident simulator"
    lede="You're on call. Pick a page, read the evidence, and decide what to do next. Every step costs time on the clock, and each choice is reviewed the way I'd review it in a postmortem."
  />
  <IncidentSimulator client:visible />
</section>
