---
import Icon from "@/components/ui/Icon.astro";
import Panel from "@/components/ui/Panel.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import StatusDot from "@/components/ui/StatusDot.astro";
import { profile } from "@/data/profile";

const featured = profile.certifications.filter((c) => c.featured);
const earlier = profile.certifications.filter((c) => !c.featured);
---

<section aria-labelledby="credentials" class="mx-auto max-w-6xl px-4 pt-24 sm:px-6" data-reveal>
  <SectionHeading
    id="credentials"
    command="cat /etc/credentials"
    title="Open source & certifications"
  />

  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <Panel title="upstream contributions">
      <ul class="space-y-5">
        {profile.openSource.map((item) => (
          <li>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <a href={item.href} class="link font-mono text-sm" rel="noopener">
                {item.project}
              </a>
              <span
                class:list={[
                  "inline-flex items-center gap-1.5 font-mono text-xs",
                  item.status === "merged" ? "text-ok" : "text-info",
                ]}
              >
                <StatusDot state={item.status === "merged" ? "ok" : "info"} />
                {item.status}
              </span>
            </div>
            <p class="mt-1 text-sm text-muted">{item.summary}</p>
          </li>
        ))}
      </ul>
    </Panel>

    <Panel title="certifications">
      <span slot="meta">{profile.certifications.length} total</span>
      <ul class="space-y-3">
        {featured.map((cert) => (
          <li class="flex gap-3">
            <StatusDot state="ok" class="mt-[0.45rem]" />
            <div>
              <p class="text-sm font-medium text-text">{cert.name}</p>
              <p class="font-mono text-xs text-muted">{cert.issuer}</p>
            </div>
          </li>
        ))}
      </ul>

      {earlier.length > 0 && (
        <details class="group mt-5 border-t border-line pt-4">
          <summary class="flex cursor-pointer list-none items-center gap-1.5 font-mono text-xs text-muted hover:text-text [&::-webkit-details-marker]:hidden">
            <Icon name="arrow" size={12} class="transition-transform group-open:rotate-90" />
            {earlier.length} earlier credentials
          </summary>
          <ul class="mt-3 space-y-2">
            {earlier.map((cert) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 text-sm">
                <span class="text-text">
                  {cert.name}
                  <span class="text-muted"> · {cert.issuer}</span>
                </span>
                <span class="font-mono text-xs text-muted">
                  {cert.issued}
                  {cert.expired && " (expired)"}
                </span>
              </li>
            ))}
          </ul>
        </details>
      )}
    </Panel>
  </div>
</section>
