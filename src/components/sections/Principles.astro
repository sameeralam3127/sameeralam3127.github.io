---
import Panel from "@/components/ui/Panel.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import StatusDot from "@/components/ui/StatusDot.astro";
import { profile } from "@/data/profile";
---

<section
  aria-labelledby="principles"
  data-tint="mint"
  class="mx-auto max-w-6xl px-4 pt-24 sm:px-6"
  data-reveal
>
  <SectionHeading
    id="principles"
    command="./healthcheck --principles"
    title="Automation-first, reliability-focused"
  />

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] lg:gap-12">
    <div class="space-y-4 text-muted">
      {profile.summary.map((paragraph) => (
        <p class="leading-relaxed">{paragraph}</p>
      ))}
    </div>

    <Panel title="healthcheck: infrastructure" bodyClass="p-0">
      <span slot="meta" class="text-ok">
        {profile.principles.length}/{profile.principles.length} passing
      </span>
      <ul class="divide-y divide-line">
        {profile.principles.map((principle) => (
          <li class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 px-4 py-3.5 sm:grid-cols-[auto_8.5rem_1fr] sm:px-5">
            <StatusDot state="ok" class="mt-[0.45rem]" />
            <span class="font-mono text-sm text-text">{principle.property}</span>
            <p class="col-start-2 text-sm leading-relaxed text-muted sm:col-start-3 sm:row-start-1">
              {principle.summary}
            </p>
          </li>
        ))}
      </ul>
    </Panel>
  </div>
</section>
