---
import Icon from "@/components/ui/Icon.astro";
import Panel from "@/components/ui/Panel.astro";
import StatusDot from "@/components/ui/StatusDot.astro";
import Tag from "@/components/ui/Tag.astro";
import { repoName, repoUrl, type Project, type ProjectStatus } from "@/data/profile";
import { timeAgo } from "@/lib/format";
import { repoStats } from "@/lib/site-data";

interface Props {
  project: Project;
  hasDeepDive: boolean;
}

const { project, hasDeepDive } = Astro.props;
const stats = project.repoPublic ? repoStats(project.repo) : undefined;

const statusState: Record<ProjectStatus, "ok" | "warn" | "info"> = {
  active: "ok",
  stable: "ok",
  "in-progress": "warn",
  rebuilding: "info",
};

const links = [
  ...(project.repoPublic ? [{ label: "Source", href: repoUrl(project.repo) }] : []),
  ...(project.links ?? []),
];
---

<Panel as="li" title={project.repoPublic ? repoName(project.repo) : "private repo"} class="h-full">
  <span slot="meta" class="inline-flex items-center gap-1.5">
    <StatusDot state={statusState[project.status]} />
    {project.statusNote ?? project.status}
  </span>

  <h3 class="text-lg font-semibold text-text">{project.name}</h3>
  <p class="mt-0.5 font-mono text-xs text-accent">{project.tagline}</p>
  <p class="mt-3 text-sm leading-relaxed text-muted">{project.description}</p>

  <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={`${project.name} stack`}>
    {project.stack.map((item) => (
      <li>
        <Tag>{item}</Tag>
      </li>
    ))}
  </ul>

  {stats && (
    <p class="mt-4 font-mono text-xs text-muted">
      ★ <span class="text-text">{stats.stars}</span>
      {stats.lastCommitAt && (
        <>
          {" "}
          · last commit <span class="text-text">{timeAgo(stats.lastCommitAt)}</span>
        </>
      )}
    </p>
  )}

  {hasDeepDive && (
    <a
      href={`/projects/${project.slug}/`}
      class="mt-4 inline-flex items-center gap-1.5 rounded border border-line-strong px-2.5 py-1 font-mono text-xs text-text hover:border-accent hover:text-accent"
    >
      read the deep dive <Icon name="arrow" size={12} />
      <span class="sr-only">on {project.name}</span>
    </a>
  )}

  {links.length > 0 && (
    <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 border-t border-line pt-4 font-mono text-xs">
      {links.map((link) => (
        <li>
          <a href={link.href} class="link inline-flex items-center gap-1" rel="noopener">
            {link.label}
            <Icon name="external" size={12} />
            <span class="sr-only">for {project.name}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Panel>
