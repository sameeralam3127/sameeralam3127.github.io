---
/**
 * Clickable, animated architecture diagram. Stages flow left → right on wide
 * screens and top → bottom on narrow ones; a packet animates along each
 * connector. Selecting a node shows its detail. A plain-text list of every
 * step is always available for screen readers and no-JS visitors.
 */
import type { Diagram, NodeKind } from "@/lib/diagram";

interface Props {
  diagram: Diagram;
}

const { diagram } = Astro.props;
const first = diagram.stages[0]?.nodes[0];
const detailId = `${diagram.id}-detail`;

const kindLabel: Record<NodeKind, string> = {
  trigger: "trigger",
  process: "process",
  check: "gate",
  store: "store",
  output: "output",
  external: "external",
};
---

<figure class="diagram panel overflow-hidden" data-diagram={diagram.id}>
  <figcaption class="panel-title">
    <span class="truncate">{diagram.title}</span>
    <span class="ml-auto shrink-0">select a step</span>
  </figcaption>

  <div class="p-4 sm:p-5">
    <ol class="flex flex-col gap-0 lg:flex-row lg:items-stretch">
      {diagram.stages.map((stage, si) => (
        <li class="flex flex-col lg:flex-1 lg:flex-row">
          {si > 0 && (
            <div class="connector" style={`--delay: ${si * 0.35}s`} aria-hidden="true">
              <span class="packet" />
            </div>
          )}
          <div class="flex min-w-0 flex-1 flex-col gap-2">
            <p class="font-mono text-[10px] tracking-widest text-muted uppercase">
              {String(si + 1).padStart(2, "0")} · {stage.label}
            </p>
            {stage.nodes.map((node) => (
              <button
                type="button"
                class="node group rounded border border-line bg-panel-2 px-3 py-2.5 text-left transition-colors hover:border-line-strong"
                aria-pressed={node.id === first?.id ? "true" : "false"}
                aria-controls={detailId}
                data-node={node.id}
                data-label={node.label}
                data-caption={node.caption ?? ""}
                data-kind={kindLabel[node.kind]}
                data-detail={node.detail}
              >
                <span class="block text-sm font-medium text-text">{node.label}</span>
                {node.caption && (
                  <span class="mt-0.5 block font-mono text-[11px] leading-snug text-muted">
                    {node.caption}
                  </span>
                )}
              </button>
            ))}
          </div>
        </li>
      ))}
    </ol>

    {first && (
      <div
        id={detailId}
        class="mt-5 rounded border border-line bg-bg/40 p-4"
        aria-live="polite"
        data-detail-pane
      >
        <p class="font-mono text-xs text-muted">
          <span data-detail-kind>{kindLabel[first.kind]}</span> ·{" "}
          <span class="text-accent" data-detail-caption>
            {first.caption}
          </span>
        </p>
        <p class="mt-1 font-medium text-text" data-detail-label>
          {first.label}
        </p>
        <p class="mt-2 text-sm leading-relaxed text-muted" data-detail-text>
          {first.detail}
        </p>
      </div>
    )}

    <details class="mt-4">
      <summary class="cursor-pointer font-mono text-xs text-muted hover:text-text">
        All steps as text
      </summary>
      <ol class="mt-3 space-y-3 text-sm">
        {diagram.stages.map((stage, si) => (
          <li>
            <p class="font-mono text-xs text-muted">
              {si + 1}. {stage.label}
            </p>
            <ul class="mt-1 space-y-1 pl-4">
              {stage.nodes.map((node) => (
                <li class="text-muted">
                  <span class="text-text">{node.label}</span>: {node.detail}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </details>
  </div>
</figure>

<style>
  .connector {
    position: relative;
    flex: none;
    align-self: center;
    width: 1px;
    height: 1.75rem;
    margin: 0.25rem 0;
    background: var(--c-line-strong);
  }

  @media (min-width: 1024px) {
    .connector {
      width: 1.75rem;
      height: 1px;
      margin: 0 0.5rem;
      align-self: center;
    }
  }

  .packet {
    position: absolute;
    left: -2px;
    top: 0;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--c-accent);
    box-shadow: 0 0 8px var(--c-accent);
    animation: packet-y 2.1s linear infinite;
    animation-delay: var(--delay, 0s);
    opacity: 0;
  }

  @media (min-width: 1024px) {
    .packet {
      top: -2px;
      left: 0;
      animation-name: packet-x;
    }
  }

  @keyframes packet-y {
    0% {
      top: 0;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 5px);
      opacity: 0;
    }
  }

  @keyframes packet-x {
    0% {
      left: 0;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 5px);
      opacity: 0;
    }
  }

  .node[aria-pressed="true"] {
    border-color: var(--c-accent);
    box-shadow: inset 0 0 0 1px var(--c-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .packet {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-diagram]").forEach((diagram) => {
    const pane = diagram.querySelector<HTMLElement>("[data-detail-pane]");
    const nodes = [...diagram.querySelectorAll<HTMLButtonElement>("[data-node]")];
    if (!pane) return;

    const fill = (selector: string, text: string) => {
      const el = pane.querySelector<HTMLElement>(selector);
      if (el) el.textContent = text;
    };

    nodes.forEach((node) => {
      node.addEventListener("click", () => {
        nodes.forEach((n) => n.setAttribute("aria-pressed", String(n === node)));
        fill("[data-detail-kind]", node.dataset.kind ?? "");
        fill("[data-detail-caption]", node.dataset.caption ?? "");
        fill("[data-detail-label]", node.dataset.label ?? "");
        fill("[data-detail-text]", node.dataset.detail ?? "");
      });
    });
  });
</script>
