---
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource-variable/jetbrains-mono";
import "@/styles/global.css";

import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import Analytics from "@/components/layout/Analytics.astro";
import CommandPalette from "@/components/islands/CommandPalette";
import { profile } from "@/data/profile";
import { getDeepDiveSlugs } from "@/lib/deep-dives";
import { buildPaletteItems } from "@/lib/palette-items";

interface Props {
  title?: string;
  description?: string;
  /** Hide the header/footer chrome (used by the 404 page). */
  bare?: boolean;
  /** Keep the page out of search indexes (no canonical URL either). */
  noindex?: boolean;
  /** Open Graph image path, e.g. "/og/index.png". */
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "article" | "profile";
  /** Structured data for this page (one schema.org object or several). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `${profile.name} — ${profile.title}`,
  description = profile.site.description,
  bare = false,
  noindex = false,
  image = "/og/index.png",
  imageAlt = `${profile.name}, ${profile.title}`,
  ogType = "website",
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL(profile.site.url);
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
// "</" can't appear inside the JSON-LD script; escape it defensively.
const structuredData = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : null;
const paletteItems = buildPaletteItems(await getDeepDiveSlugs());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    <meta name="theme-color" content="#111217" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Runs before first paint: applies the saved theme (or the OS preference) and
      marks JS as available so reveal animations never hide content without it.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {
          /* storage unavailable: follow the OS */
        }
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme =
          saved === "light" || saved === "dark" ? saved : prefersDark ? "dark" : "light";
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col antialiased">
    <a
      href="#main"
      class="sr-only z-[70] rounded-full bg-btn px-4 py-2 font-mono text-sm text-btn-ink focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Skip to content
    </a>
    {!bare && <SiteHeader />}
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    {!bare && <SiteFooter />}
    <CommandPalette client:idle items={paletteItems} email={profile.contact.email} />
    <Analytics />

    <script>
      // Reveal sections as they scroll into view. Skipped entirely when the
      // visitor prefers reduced motion (CSS already shows everything).
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || !("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
